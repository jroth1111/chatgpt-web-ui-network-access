# Non-secret configuration only. Never commit your actual .env or secrets.
# Set these as ChatGPT Sites environment bindings (Site settings), not here.
TRAWL_URL=https://your-trawl-endpoint.example.com
TRAWL_TOKEN=your-basic-auth-password
# Preserve these exact existing values privately when updating a deployed Site.
OWNER_EMAIL=owner@example.com
ORIGIN=https://your-site.example.com
# PROJECT_ID is optional provenance metadata assigned by Sites.
